# Copy to .env and fill in. Never commit .env (it is git-ignored). Variable names map to
# fpl_api.settings.Settings (prefix FPL_); list values are JSON arrays.
POSTGRES_USER=fpl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fpl
FPL_DATABASE_URL=postgresql+psycopg://fpl:change-me@postgres:5432/fpl
FPL_REDIS_URL=redis://redis:6379/0
FPL_ENVIRONMENT=production
# API keys: store only SHA-256 hashes (generate a key + hash with `fpl-api create-key`).
# Operator keys (operations, smoke tests) have full access. The web proxy's key goes in the
# WEB list: with it alone the API serves public reference data only; manager data needs a
# signed-in user (invite-only accounts; create invitations with `fpl-api create-invite`).
FPL_REQUIRE_API_KEY=true
FPL_API_KEYS_SHA256=[]
FPL_WEB_API_KEYS_SHA256=[]
FPL_CORS_ORIGINS=["http://localhost:3000"]
# Manager webhooks may only target these HTTPS hosts (SSRF protection, §75).
FPL_WEBHOOK_ALLOWED_HOSTS=[]
# Live FPL source; set false where the network policy forbids fantasy.premierleague.com.
FPL_LIVE_SYNC_ENABLED=true
# Retention of hourly live snapshots and their caches (0 disables pruning; pinned evaluation,
# serving and recommendation-referenced snapshots are always kept).
FPL_SNAPSHOT_RETENTION_KEEP=24
FPL_ARTIFACT_RETENTION_HOURS=24
# Solver processes per recommendation job in the worker (stability perturbations and chip weeks
# solved in parallel; results are identical for any value). Set to the worker's vCPUs; each
# process needs up to ~250 MB. The API always uses 1.
FPL_SOLVER_WORKERS=2
# Web UI: the Next server proxies /backend/* to the API with this key (never sent to browsers);
# its hash belongs in FPL_WEB_API_KEYS_SHA256 above, not in the operator list.
FPL_WEB_API_KEY=
